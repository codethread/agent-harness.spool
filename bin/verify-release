#!/usr/bin/env bash
set -euo pipefail

# Repository-private release gate. Release evidence is parsed once before any
# network, build, or runtime work; malformed or misaligned pins fail closed.
usage() {
  cat >&2 <<'EOF'
repository-private usage:
  bin/verify-release --mode pre-tag --source-root DIR \
    --core-release release/msr04-release.json \
    --kanban-release release/msr05-release.json
  bin/verify-release --mode published --repository URL --tag vN --sha SHA \
    --core-release release/msr04-release.json \
    --kanban-release release/msr05-release.json
EOF
  exit 2
}

die() { echo "verify-release: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing command $1"; }

seen_options=""
claim_option() {
  local option=$1
  case " $seen_options " in
    *" $option "*) die "duplicate option: $option" ;;
  esac
  seen_options="${seen_options}${seen_options:+ }$option"
}

mode=""
source_root=""
repository=""
tag=""
sha=""
core_release=""
kanban_release=""
help_requested=0
while (($# > 0)); do
  case "$1" in
    --mode) claim_option "$1"; [[ $# -ge 2 ]] || usage; mode=$2; shift 2 ;;
    --source-root) claim_option "$1"; [[ $# -ge 2 ]] || usage; source_root=$2; shift 2 ;;
    --repository) claim_option "$1"; [[ $# -ge 2 ]] || usage; repository=$2; shift 2 ;;
    --tag) claim_option "$1"; [[ $# -ge 2 ]] || usage; tag=$2; shift 2 ;;
    --sha) claim_option "$1"; [[ $# -ge 2 ]] || usage; sha=$2; shift 2 ;;
    --core-release) claim_option "$1"; [[ $# -ge 2 ]] || usage; core_release=$2; shift 2 ;;
    --kanban-release) claim_option "$1"; [[ $# -ge 2 ]] || usage; kanban_release=$2; shift 2 ;;
    -h|--help) claim_option --help; help_requested=1; shift ;;
    *) echo "verify-release: unknown argument: $1" >&2; usage ;;
  esac
done

((help_requested == 0)) || usage
[[ "$mode" == pre-tag || "$mode" == published ]] || usage
[[ -f "$core_release" ]] || die "--core-release must name a JSON file"
[[ -f "$kanban_release" ]] || die "--kanban-release must name a JSON file"
need git
need python3
need clojure

if [[ "$mode" == pre-tag ]]; then
  [[ -n "$source_root" && -d "$source_root" ]] || die "--source-root must name a directory"
  [[ -z "$repository" && -z "$tag" && -z "$sha" ]] || \
    die "--repository, --tag, and --sha are published-mode options"
  source_root=$(cd "$source_root" && pwd -P)
  [[ -d "$source_root/.git" || -f "$source_root/.git" ]] || \
    die "source root is not a Git checkout: $source_root"
else
  [[ -z "$source_root" ]] || die "--source-root is a pre-tag option"
  [[ -n "$repository" && -n "$tag" && -n "$sha" ]] || \
    die "published mode requires --repository, --tag, and --sha"
  [[ "$tag" =~ ^v[0-9]+$ ]] || die "tag must be an annotated v<int> marker"
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die "sha must be a lowercase 40-hex commit"
  [[ "$repository" != *"../"* && "$repository" != /* ]] || \
    die "published repository must not be a local path"
fi

tmp_root=$(mktemp -d /tmp/ah-release.XXXXXX)
mill_pid=""
weaver_active=0
cleanup() {
  local rc=$?
  if ((weaver_active)); then
    XDG_STATE_HOME="$state_root" MILLSTRAND_SOURCE="$core_root" \
      "$mill_bin" weaver stop --workspace "$workspace_root" >/dev/null 2>&1 || true
  fi
  if [[ -n "$mill_pid" ]] && kill -0 "$mill_pid" 2>/dev/null; then
    kill "$mill_pid" 2>/dev/null || true
    wait "$mill_pid" 2>/dev/null || true
  fi
  rm -rf "$tmp_root"
  trap - EXIT
  exit "$rc"
}
trap cleanup EXIT

if [[ "$mode" == published ]]; then
  remote_sha=$(git ls-remote "$repository" "refs/tags/$tag^{}" | awk 'NR == 1 {print $1}')
  [[ "$remote_sha" == "$sha" ]] || \
    die "tag $tag resolves to ${remote_sha:-<no peeled SHA>}, expected $sha"
  git clone --quiet --depth 1 --branch "$tag" "$repository" "$tmp_root/candidate"
  candidate_root="$tmp_root/candidate"
  [[ "$(git -C "$candidate_root" rev-parse HEAD)" == "$sha" ]] || \
    die "checked-out $tag does not match $sha"
  release_ref="$tag@$sha"
else
  mkdir "$tmp_root/candidate"
  cp -R "$source_root/." "$tmp_root/candidate/"
  rm -f "$tmp_root/candidate/.millstrand/config.local.json" \
        "$tmp_root/candidate/.millstrand/deps.local.edn" \
        "$tmp_root/candidate/.millstrand/init.local.clj"
  chmod -R u+rwX "$tmp_root/candidate"
  candidate_root="$tmp_root/candidate"
  release_ref="candidate:$(git -C "$source_root" rev-parse HEAD)"
fi

[[ -f "$candidate_root/deps.edn" ]] || die "candidate is missing deps.edn"
[[ -f "$candidate_root/.millstrand/deps.edn" ]] || \
  die "candidate workspace is missing deps.edn"

release_error=$(python3 - "$core_release" "$kanban_release" <<'PY'
import json, sys

core_path, millhouse_path = sys.argv[1:]

def load_release(label, path):
    def reject_duplicate_keys(pairs):
        document = {}
        duplicates = set()
        for key, value in pairs:
            if key in document:
                duplicates.add(key)
            document[key] = value
        if duplicates:
            raise SystemExit(
                f"{label} release metadata has duplicate fields: {', '.join(sorted(duplicates))}"
            )
        return document

    with open(path, encoding="utf-8") as handle:
        return json.load(handle, object_pairs_hook=reject_duplicate_keys)

core = load_release("MSR-04", core_path)
millhouse = load_release("MSR-05", millhouse_path)
expected = [
    ("MSR-04", core, {"card": "MSR-04", "repository": "codethread/millstrand",
                       "coordinate": "io.millstrand/millstrand", "ref-kind": "sha",
                       "sha": "71c0ed3d80fcad090b74a704a8eb165a3fad996e",
                       "landed-main-commit": "71c0ed3d80fcad090b74a704a8eb165a3fad996e"}),
    ("MSR-05", millhouse, {"card": "MSR-05", "repository": "codethread/millhouse.spool",
                            "coordinate": "millhouse.spools/kanban", "ref-kind": "sha",
                            "sha": "f487eb42ea9523e8bd405e64a7c319013217d988",
                            "landed-main-commit": "f487eb42ea9523e8bd405e64a7c319013217d988"}),
]
for label, document, identity in expected:
    if not isinstance(document, dict):
        raise SystemExit(f"{label} release metadata must be a JSON object")
    supported_fields = set(identity) | {"land-run", "verification"}
    unexpected_fields = sorted(set(document) - supported_fields)
    missing_fields = sorted(supported_fields - set(document))
    if unexpected_fields:
        raise SystemExit(
            f"{label} release metadata has unsupported fields: {', '.join(unexpected_fields)}"
        )
    if missing_fields:
        raise SystemExit(
            f"{label} release metadata lacks required fields: {', '.join(missing_fields)}"
        )
    if any(document.get(key) != value for key, value in identity.items()):
        raise SystemExit(f"{label} release metadata does not identify the pinned commit")
    if not isinstance(document.get("land-run"), str) or not document["land-run"]:
        raise SystemExit(f"{label} release metadata lacks required land evidence")
    if not isinstance(document.get("verification"), list) or not document["verification"]:
        raise SystemExit(f"{label} release metadata lacks required verification evidence")
PY
) || die "release evidence is invalid: $release_error"

pins=$(clojure -Sdeps '{:deps {}}' -M -e '
(require (quote [clojure.edn :as edn])
         (quote [clojure.java.io :as io]))
(let [read-edn-file (fn [path]
                      (with-open [reader (java.io.PushbackReader. (io/reader path))]
                        (let [eof (Object.)
                              value (edn/read {:eof eof} reader)]
                          (when (identical? value eof)
                            (throw (ex-info (str path " is empty") {})))
                          (when-not (identical? (edn/read {:eof eof} reader) eof)
                            (throw (ex-info (str path " contains trailing EDN forms") {})))
                          value)))
      [root-path workspace-path] *command-line-args*
      root (read-edn-file root-path)
      workspace (read-edn-file workspace-path)
      core-sha "71c0ed3d80fcad090b74a704a8eb165a3fad996e"
      millhouse-sha "f487eb42ea9523e8bd405e64a7c319013217d988"
      core-url "https://github.com/codethread/millstrand.git"
      millhouse-url "https://github.com/codethread/millhouse.spool.git"
      core-pin {:git/url core-url :git/sha core-sha :deps/root "."}
      batteries-pin {:git/url core-url :git/sha core-sha :deps/root "spools/batteries"}
      millhouse-roots {(quote millhouse.spools/workflow) "spools/workflow"
                       (quote millhouse.spools/identity) "spools/identity"
                       (quote millhouse.spools/kanban) "spools/kanban"}
      millhouse-pin (fn [coordinate]
                      {:git/url millhouse-url :git/sha millhouse-sha
                       :deps/root (get millhouse-roots coordinate)})
      alias-sources [["root" (:aliases root)]
                     ["workspace" (:aliases workspace)]]
      alias-dep-keys [:deps :extra-deps :override-deps :default-deps :replace-deps]]
  (when-not (= (get-in root [:deps (quote io.millstrand/millstrand)]) core-pin)
    (throw (ex-info "candidate root Millstrand pin is not the exact release coordinate" {})))
  (when-not (= (get-in root [:deps (quote millstrand.spools/batteries)]) batteries-pin)
    (throw (ex-info "candidate root Batteries pin is not aligned with Millstrand" {})))
  (when-not (= (get-in workspace [:deps (quote millstrand.spools/batteries)]) batteries-pin)
    (throw (ex-info "candidate workspace Batteries pin is not aligned with Millstrand" {})))
  (when-let [workspace-core (get-in workspace [:deps (quote io.millstrand/millstrand)])]
    (when-not (= workspace-core core-pin)
      (throw (ex-info "candidate workspace Millstrand pin is not the exact release coordinate" {}))))
  (doseq [[source aliases] alias-sources
          [alias config] aliases
          dep-key alias-dep-keys
          [coordinate expected] [[(quote io.millstrand/millstrand) core-pin]
                                 [(quote millstrand.spools/batteries) batteries-pin]]
          :let [actual (get-in config [dep-key coordinate])]
          :when actual]
    (when-not (= actual expected)
      (throw (ex-info (str "candidate " source " " coordinate " pin disagrees in alias " alias
                           " (" dep-key ")") {}))))
  (doseq [[coordinate root-name] millhouse-roots
          :let [expected (millhouse-pin coordinate)
                root-pin (get-in root [:deps coordinate])
                workspace-pin (get-in workspace [:deps coordinate])]]
    (when (and root-pin (not= root-pin expected))
      (throw (ex-info (str "candidate root " coordinate " pin is not the exact Millhouse release coordinate") {})))
    (when-not (= workspace-pin expected)
      (throw (ex-info (str "candidate workspace " coordinate " pin is not the exact Millhouse release coordinate") {})))
    (doseq [[source aliases] alias-sources
            [alias config] aliases
            dep-key alias-dep-keys
            :let [actual (get-in config [dep-key coordinate])]
            :when actual]
      (when-not (= actual expected)
        (throw (ex-info (str "candidate " source " " coordinate " pin disagrees in alias " alias
                             " (" dep-key ")") {})))))
  (println core-url)
  (println core-sha)
  (println millhouse-url)
  (println millhouse-sha))
' - "$candidate_root/deps.edn" "$candidate_root/.millstrand/deps.edn" 2>&1) || \
  die "release evidence is invalid: $pins"
expected_pins=$(printf '%s\n' \
  "https://github.com/codethread/millstrand.git" \
  "71c0ed3d80fcad090b74a704a8eb165a3fad996e" \
  "https://github.com/codethread/millhouse.spool.git" \
  "f487eb42ea9523e8bd405e64a7c319013217d988")
[[ "$pins" == "$expected_pins" ]] || \
  die "release evidence parser returned malformed output: $pins"
core_url=$(sed -n '1p' <<<"$pins")
core_sha=$(sed -n '2p' <<<"$pins")
millhouse_sha=$(sed -n '4p' <<<"$pins")

consumer_root="$tmp_root/consumer"
gitlibs_root="$tmp_root/gitlibs"
mkdir "$consumer_root"
cat >"$consumer_root/deps.edn" <<EOF
{:paths ["$candidate_root/agent-run/src"
         "$candidate_root/harness-core/src"
         "$candidate_root/claude-harness/src"
         "$candidate_root/codex-harness/src"
         "$candidate_root/cursor-harness/src"
         "$candidate_root/pi-harness/src"
         "$candidate_root/agent-cli/src"
         "$candidate_root/delegation/src"
         "$candidate_root/bench/src"]
 :deps {io.millstrand/millstrand {:git/url "$core_url" :git/sha "$core_sha" :deps/root "."}
        millstrand.spools/batteries {:git/url "$core_url" :git/sha "$core_sha" :deps/root "spools/batteries"}
        millhouse.spools/workflow {:git/url "https://github.com/codethread/millhouse.spool.git" :git/sha "$millhouse_sha" :deps/root "spools/workflow"}
        millhouse.spools/identity {:git/url "https://github.com/codethread/millhouse.spool.git" :git/sha "$millhouse_sha" :deps/root "spools/identity"}}}
EOF
classpath=$(cd "$consumer_root" && GITLIBS="$gitlibs_root" clojure -Spath 2>&1) || \
  die "clean consumer dependency resolution failed: $classpath"
smoke=$(cd "$consumer_root" && GITLIBS="$gitlibs_root" clojure -M -e '
  (doseq [ns (quote [ct.spools.agent-run ct.spools.delegation
                     ct.spools.executors.subagent ct.spools.harness-core
                     ct.spools.claude-harness ct.spools.codex-harness
                     ct.spools.pi-harness ct.spools.cursor-harness
                     ct.spools.agent-cli ct.spools.bench])]
    (require ns))
  (println :agent-harness-consumer-loaded)
' 2>&1) || die "clean consumer load failed: $smoke"

core_root="$tmp_root/millstrand"
git clone --quiet "$core_url" "$core_root"
git -C "$core_root" checkout --quiet "$core_sha"
need go
mkdir "$core_root/bin"
build_id=$(git -C "$core_root" rev-parse --short HEAD)
for name_and_package in 'mill ./cli/cmd/mill' 'strand ./cli/cmd/strand'; do
  read -r name package <<<"$name_and_package"
  (cd "$core_root" && go build \
    -ldflags "-X millstrand-strand-cli/internal/config.InstalledSource=$core_root -X millstrand-strand-cli/internal/config.BuildID=$build_id" \
    -o "$core_root/bin/$name" "$package") || die "failed to build pinned core $name"
done
mill_bin="$core_root/bin/mill"
strand_bin="$core_root/bin/strand"

state_root="$tmp_root/state"
workspace_root="$tmp_root/workspace"
mkdir "$state_root" "$workspace_root"
cp -R "$candidate_root/.millstrand/." "$workspace_root/"
for root in harness-core claude-harness codex-harness cursor-harness pi-harness agent-cli agent-run delegation bench; do
  ln -s "$candidate_root/$root" "$tmp_root/$root"
done
cat >"$workspace_root/init.clj" <<'EOF'
(require '[millstrand.api.current.alpha :as current]
         '[millstrand.api.runtime.alpha :as runtime])

(def release-runtime (current/runtime))
(runtime/module! release-runtime :millstrand/spools-batteries
  {:ns 'millstrand.spools.batteries})
(runtime/module! release-runtime :millhouse/spools-identity
  {:ns 'millhouse.spools.identity :required? true})
(runtime/module! release-runtime :millstrand/spools-agent-run
  {:ns 'ct.spools.agent-run :after [:millhouse/spools-identity] :required? true})
(runtime/module! release-runtime :millstrand/spools-delegation
  {:ns 'ct.spools.delegation :after [:millstrand/spools-agent-run] :required? true})
EOF
cat >"$workspace_root/config/release-smoke.clj" <<'EOF'
(ns release-smoke
  (:require [millstrand.api.current.alpha :as release-current]
            [millstrand.api.lifecycle.alpha :as release-lifecycle]
            [ct.spools.agent-run :as release-agent-run]
            [ct.spools.delegation :as release-delegation]))

(release-agent-run/defharnesses! release-smoke-harnesses
  "Disposable release verifier harness."
  {:release-smoke {:argv ["sh" "-c" "printf '%s\\n' '{\"type\":\"thread.started\",\"thread_id\":\"release-smoke\"}' '{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"release smoke\"}}' '{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":2000,\"cached_input_tokens\":500,\"output_tokens\":100,\"reasoning_output_tokens\":20}}'"]
                   :parse :codex-json
                   :preamble? false
                   :cost-rates {:input 1.0 :cache-read 0.1 :output 6.0}}})

(defn open-release-smoke! [{:keys [runtime]}]
  (release-current/with-runtime runtime
    (release-agent-run/set-default-review-contract! release-delegation/review-contract)
    (release-agent-run/set-default-task-contract! release-delegation/worker-contract))
  {:opened :release-smoke})

(defn close-release-smoke! [{:keys [runtime]}]
  (release-current/with-runtime runtime
    (release-agent-run/set-default-review-contract! nil)
    (release-agent-run/set-default-task-contract! nil))
  {:closed :release-smoke})

(release-lifecycle/defresource! release-smoke-runtime
  "Own the disposable release smoke contracts."
  {:open 'release-smoke/open-release-smoke!
   :close 'release-smoke/close-release-smoke!})
EOF
cat >"$workspace_root/init.local.clj" <<'EOF'
(require '[millstrand.api.current.alpha :as release-current]
         '[millstrand.api.runtime.alpha :as release-runtime])

(release-runtime/module! (release-current/runtime) :release/smoke
  {:file "config/release-smoke.clj"
   :after [:millstrand/spools-agent-run :millstrand/spools-delegation]
   :required? true})
EOF

mill_log="$tmp_root/mill.log"
XDG_STATE_HOME="$state_root" MILLSTRAND_SOURCE="$core_root" "$mill_bin" start >"$mill_log" 2>&1 &
mill_pid=$!
deadline=$((SECONDS + 30))
until XDG_STATE_HOME="$state_root" "$mill_bin" status >/dev/null 2>&1; do
  kill -0 "$mill_pid" 2>/dev/null || die "mill exited before becoming ready: $(sed -n '1,80p' "$mill_log")"
  ((SECONDS < deadline)) || die "mill did not become ready within 30s"
  sleep 0.05
done
mill_cmd() { XDG_STATE_HOME="$state_root" MILLSTRAND_SOURCE="$core_root" "$mill_bin" "$@"; }
strand_cmd() { XDG_STATE_HOME="$state_root" "$strand_bin" --workspace "$workspace_root" "$@"; }
mill_cmd weaver start --workspace "$workspace_root" >/dev/null
weaver_active=1

task=$(strand_cmd add "release smoke" --attr body=release-smoke)
task_id=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])' <<<"$task")
delegate=$(strand_cmd agent delegate "$task_id" --harness release-smoke --cwd "$candidate_root")
delegate_run=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["run"]["id"])' <<<"$delegate")
awaited=$(strand_cmd agent await "$delegate_run" --timeout-secs 30)
python3 - "$awaited" <<'PY'
import json, sys
result = json.loads(sys.argv[1])
runs = result.get("runs", [])
if result.get("timed-out") or len(runs) != 1 or runs[0].get("phase") != "done":
    raise SystemExit(f"delegate/await smoke failed: {result}")
PY
review=$(strand_cmd agent review "$task_id" --seats 1 --harness release-smoke --cwd "$candidate_root" --changed-files bin/verify-release)
review_run=$(python3 -c 'import json,sys; reviewers=json.load(sys.stdin)["reviewers"]; assert len(reviewers) == 1; print(reviewers[0])' <<<"$review")
strand_cmd agent await "$review_run" --timeout-secs 30 >/dev/null
spend=$(strand_cmd agent spend --group-by harness)
python3 - "$spend" <<'PY'
import json, sys
spend = json.loads(sys.argv[1])
expected_cost = 2 * ((1500 / 1_000_000) + (500 / 1_000_000) * .1 + (100 / 1_000_000) * 6)
if spend.get("totals", {}).get("tokens-total") != 4200:
    raise SystemExit(f"token accounting smoke failed: {spend}")
if abs(spend["totals"].get("cost-usd", -1) - expected_cost) > 1e-12:
    raise SystemExit(f"cost accounting smoke failed: {spend}")
if len(spend.get("runs", [])) != 2:
    raise SystemExit(f"delegate/review accounting smoke failed: {spend}")
PY

output_dir="$candidate_root/target/release"
mkdir -p "$output_dir"
python3 - "$output_dir/$mode.json" "$mode" "$release_ref" "$core_sha" "$millhouse_sha" <<'PY'
import json, sys
path, mode, release, core_sha, millhouse_sha = sys.argv[1:]
with open(path, "w", encoding="utf-8") as handle:
    json.dump({"mode": mode, "release": release, "core-sha": core_sha,
               "millhouse-sha": millhouse_sha,
               "consumer": "ct.spools/agent-run",
               "agent-smoke": {"delegate": True, "await": True,
                               "review": True, "spend": True,
                               "tokens-total": 4200}}, handle, indent=2)
    handle.write("\n")
PY

echo "agent-harness release verification: clean"
echo "  mode: $mode"
echo "  release: $release_ref"
echo "  core: codethread/millstrand@$core_sha"
echo "  millhouse: codethread/millhouse.spool@$millhouse_sha"
echo "  evidence: $output_dir/$mode.json"
