#!/usr/bin/env bash
set -euo pipefail

# Repository-private release gate. This is maintainer tooling invoked by the
# Makefile; it is not a shipped or supported agent-harness user CLI. Keep its
# local parser strict so malformed release evidence fails before any smoke work.
usage() {
  cat >&2 <<'EOF'
repository-private usage:
  bin/verify-release --mode pre-tag --source-root DIR \
    --core-release release/msr04-release.json \
    --kanban-release release/msr05-release.json
  bin/verify-release --mode published --repository URL --tag vN --sha SHA \
    --core-release release/msr04-release.json \
    --kanban-release release/msr05-release.json
EOF
  exit 2
}

die() { echo "verify-release: $*" >&2; exit 1; }

seen_options=""
claim_option() {
  local option=$1
  case " $seen_options " in
    *" $option "*) die "duplicate option: $option" ;;
  esac
  seen_options="${seen_options}${seen_options:+ }$option"
}

mode=""
source_root=""
repository=""
tag=""
sha=""
core_release=""
kanban_release=""
help_requested=0

while (($# > 0)); do
  case "$1" in
    --mode) claim_option "$1"; [[ $# -ge 2 ]] || usage; mode=$2; shift 2 ;;
    --source-root) claim_option "$1"; [[ $# -ge 2 ]] || usage; source_root=$2; shift 2 ;;
    --repository) claim_option "$1"; [[ $# -ge 2 ]] || usage; repository=$2; shift 2 ;;
    --tag) claim_option "$1"; [[ $# -ge 2 ]] || usage; tag=$2; shift 2 ;;
    --sha) claim_option "$1"; [[ $# -ge 2 ]] || usage; sha=$2; shift 2 ;;
    --core-release) claim_option "$1"; [[ $# -ge 2 ]] || usage; core_release=$2; shift 2 ;;
    --kanban-release) claim_option "$1"; [[ $# -ge 2 ]] || usage; kanban_release=$2; shift 2 ;;
    -h|--help) claim_option "--help"; help_requested=1; shift ;;
    *) echo "verify-release: unknown argument: $1" >&2; usage ;;
  esac
done

(( help_requested == 0 )) || usage
need() { command -v "$1" >/dev/null 2>&1 || die "missing command $1"; }
[[ "$mode" == "pre-tag" || "$mode" == "published" ]] || usage
[[ -f "$core_release" ]] || die "--core-release must name a JSON file"
[[ -f "$kanban_release" ]] || die "--kanban-release must name a JSON file"
need git
need python3
need clojure

release_values=$(python3 - "$core_release" "$kanban_release" <<'PY'
import json
import re
import sys

core_path, kanban_path = sys.argv[1:]
with open(core_path, encoding="utf-8") as handle:
    core = json.load(handle)
with open(kanban_path, encoding="utf-8") as handle:
    kanban = json.load(handle)

required_core = {
    "card", "repository", "coordinate", "ref-kind", "sha",
    "landed-main-commit", "land-run", "verification",
}
missing = sorted(required_core - core.keys())
if missing:
    raise SystemExit(f"core release is missing fields: {', '.join(missing)}")
forbidden = sorted({"tag", "peeled-sha"} & core.keys())
if forbidden:
    raise SystemExit(f"core release contains forbidden fields: {', '.join(forbidden)}")
if core["card"] != "MSR-04" or core["repository"] != "codethread/millstrand":
    raise SystemExit("core release identity does not match MSR-04")
if core["coordinate"] != "io.millstrand/millstrand" or core["ref-kind"] != "sha":
    raise SystemExit("core release must use io.millstrand/millstrand SHA identity")
for field in ("sha", "landed-main-commit"):
    if not re.fullmatch(r"[0-9a-f]{40}", core[field]):
        raise SystemExit(f"core release {field} must be a lowercase 40-hex SHA")
if core["sha"] != core["landed-main-commit"]:
    raise SystemExit("core release SHA must equal landed-main-commit")
if not isinstance(core["verification"], list) or not core["verification"]:
    raise SystemExit("core release verification must be a non-empty array")

required_kanban = {
    "card", "repository", "coordinate", "tag", "peeled-sha",
    "landed-main-commit", "land-run", "verification",
}
missing = sorted(required_kanban - kanban.keys())
if missing:
    raise SystemExit(f"Kanban release is missing fields: {', '.join(missing)}")
if kanban["card"] != "MSR-05" or kanban["repository"] != "codethread/kanban.spool":
    raise SystemExit("Kanban release identity does not match MSR-05")
if kanban["coordinate"] != "codethread/kanban" or not re.fullmatch(r"v[0-9]+", kanban["tag"]):
    raise SystemExit("Kanban release has an invalid coordinate or tag")
for field in ("peeled-sha", "landed-main-commit"):
    if not re.fullmatch(r"[0-9a-f]{40}", kanban[field]):
        raise SystemExit(f"Kanban release {field} must be a lowercase 40-hex SHA")
if kanban["peeled-sha"] != kanban["landed-main-commit"]:
    raise SystemExit("Kanban peeled SHA must equal landed-main-commit")
if not isinstance(kanban["verification"], list) or not kanban["verification"]:
    raise SystemExit("Kanban verification must be a non-empty array")

print(core["repository"])
print(core["coordinate"])
print(core["sha"])
print(kanban["repository"])
print(kanban["coordinate"])
print(kanban["tag"])
print(kanban["peeled-sha"])
PY
)
core_repository=$(printf '%s\n' "$release_values" | sed -n '1p')
core_coordinate=$(printf '%s\n' "$release_values" | sed -n '2p')
core_sha=$(printf '%s\n' "$release_values" | sed -n '3p')
kanban_repository=$(printf '%s\n' "$release_values" | sed -n '4p')
kanban_coordinate=$(printf '%s\n' "$release_values" | sed -n '5p')
kanban_tag=$(printf '%s\n' "$release_values" | sed -n '6p')
kanban_sha=$(printf '%s\n' "$release_values" | sed -n '7p')
core_url="https://github.com/${core_repository%.git}.git"
kanban_url="https://github.com/${kanban_repository%.git}.git"
millhouse_repository="codethread/millhouse.spool"
millhouse_coordinate="millhouse.spools/workflow"
millhouse_sha="b0ac2268685e53510df01dcd0cc533b8fd40a25d"
millhouse_url="https://github.com/${millhouse_repository}.git"

if [[ "$mode" == "pre-tag" ]]; then
  [[ -n "$source_root" && -d "$source_root" ]] || die "--source-root must name a directory"
  [[ -z "$repository" && -z "$tag" && -z "$sha" ]] || \
    die "--repository, --tag, and --sha are published-mode options"
  source_root=$(cd "$source_root" && pwd -P)
  [[ -d "$source_root/.git" || -f "$source_root/.git" ]] || \
    die "source root is not a Git checkout: $source_root"
  release_ref="candidate:$(git -C "$source_root" rev-parse HEAD)"
else
  [[ -z "$source_root" ]] || die "--source-root is a pre-tag option"
  [[ -n "$repository" && -n "$tag" && -n "$sha" ]] || \
    die "published mode requires --repository, --tag, and --sha"
  [[ "$tag" =~ ^v[0-9]+$ ]] || die "tag must be an annotated v<int> marker"
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || die "sha must be a lowercase 40-hex commit"
  [[ "$repository" != *"../"* && "$repository" != /* ]] || \
    die "published repository must not be a local path"
  remote_sha=$(git ls-remote "$repository" "refs/tags/$tag^{}" | awk 'NR == 1 {print $1}')
  [[ "$remote_sha" == "$sha" ]] || \
    die "tag $tag resolves to ${remote_sha:-<no peeled SHA>}, expected $sha"
  tmp_root=$(mktemp -d /tmp/ah.XXXXXX)
  git clone --quiet --depth 1 --branch "$tag" "$repository" "$tmp_root/agent-harness"
  candidate_root="$tmp_root/agent-harness"
  [[ "$(git -C "$candidate_root" rev-parse HEAD)" == "$sha" ]] || \
    die "checked-out $tag does not match $sha"
  release_ref="$tag@$sha"
fi

tmp_root=${tmp_root:-$(mktemp -d /tmp/ah.XXXXXX)}
if [[ "$mode" == "pre-tag" ]]; then
  # Verify a disposable copy so evidence and generated metadata never touch
  # the caller's checkout. Copy the complete worktree so pre-tag checks cover
  # uncommitted candidate changes, and keep read-only source roots viable.
  mkdir -p "$tmp_root/agent-harness"
  cp -R "$source_root/." "$tmp_root/agent-harness/"
  # Do not inherit developer-owned Millstrand overlays into the disposable
  # candidate. Leave init.local.clj alone: the release workspace writes its
  # intentional generated version below after projecting candidate spools.
  rm -f "$tmp_root/agent-harness/.millstrand/config.local.json" \
        "$tmp_root/agent-harness/.millstrand/spools.local.edn"
  chmod -R u+rwX "$tmp_root/agent-harness"
  candidate_root="$tmp_root/agent-harness"
fi
consumer_root="$tmp_root/consumer"
gitlibs_root="$tmp_root/.gitlibs"
mkdir -p "$consumer_root"
cleanup() {
  local rc=$?
  if [[ "${weaver_active:-0}" == 1 ]]; then
    XDG_STATE_HOME="$state_root" MILLSTRAND_SOURCE="$core_root" \
      "$mill_bin" weaver stop --workspace "$weaver_workspace" >/dev/null 2>&1 || true
  fi
  if [[ -n "${mill_pid:-}" ]] && kill -0 "$mill_pid" 2>/dev/null; then
    kill "$mill_pid" 2>/dev/null || true
    wait "$mill_pid" 2>/dev/null || true
  fi
  rm -rf "$tmp_root"
  trap - EXIT
  exit "$rc"
}
trap cleanup EXIT

core_root="$tmp_root/millstrand"
git clone --quiet "$core_url" "$core_root"
git -C "$core_root" checkout --quiet "$core_sha"
[[ "$(git -C "$core_root" rev-parse HEAD)" == "$core_sha" ]] || \
  die "resolved core checkout does not match $core_sha"

build_core_binary() {
  local name=$1
  local package=$2
  local output="$core_root/bin/$name"
  local build_id
  need go
  build_id=$(git -C "$core_root" rev-parse --short HEAD)
  mkdir -p "$core_root/bin"
  (cd "$core_root" && \
    go build -ldflags "-X millstrand-strand-cli/internal/config.InstalledSource=$core_root -X millstrand-strand-cli/internal/config.BuildID=$build_id" \
      -o "$output" "$package") || \
    die "failed to build pinned core $name at $core_sha"
  [[ -x "$output" ]] || die "pinned core build did not produce executable $output"
}

cat >"$consumer_root/deps.edn" <<EOF
{:paths ["$candidate_root/agent-run/src"
         "$candidate_root/harness-core/src"
         "$candidate_root/claude-harness/src"
         "$candidate_root/codex-harness/src"
         "$candidate_root/cursor-harness/src"
         "$candidate_root/pi-harness/src"
         "$candidate_root/agent-cli/src"
         "$candidate_root/delegation/src"
         "$candidate_root/bench/src"]
 :deps {$core_coordinate {:git/url "$core_url" :git/sha "$core_sha"}
        $millhouse_coordinate {:git/url "$millhouse_url"
                               :git/sha "$millhouse_sha"
                               :deps/root "spools/workflow"}
        $kanban_coordinate {:git/url "$kanban_url" :git/tag "$kanban_tag" :git/sha "$kanban_sha"}}}
EOF
if grep -Eq ':local/root|:source-root' "$consumer_root/deps.edn"; then
  die "generated consumer metadata contains a local/root or source-root override"
fi

classpath=$(cd "$consumer_root" && GITLIBS="$gitlibs_root" clojure -Spath 2>&1) || \
  die "clean consumer dependency resolution failed: $classpath"
smoke=$(cd "$consumer_root" && GITLIBS="$gitlibs_root" clojure -M -e '
  (doseq [ns (quote [ct.spools.agent-run ct.spools.delegation
                    ct.spools.executors.subagent ct.spools.harness-core
                    ct.spools.claude-harness ct.spools.codex-harness
                    ct.spools.pi-harness ct.spools.cursor-harness
                    ct.spools.agent-cli ct.spools.bench])]
    (require ns))
  (println :agent-harness-consumer-loaded)
' 2>&1) || die "clean consumer load failed: $smoke"

mill_bin=${MILL_BIN:-}
if [[ -z "$mill_bin" ]]; then
  build_core_binary mill ./cli/cmd/mill
  mill_bin="$core_root/bin/mill"
fi
[[ -n "$mill_bin" && -x "$mill_bin" ]] || \
  die "missing mill executable; set MILL_BIN to the published Millstrand mill"
strand_bin=${STRAND_BIN:-}
if [[ -z "$strand_bin" ]]; then
  build_core_binary strand ./cli/cmd/strand
  strand_bin="$core_root/bin/strand"
fi
[[ -n "$strand_bin" && -x "$strand_bin" ]] || \
  die "missing strand executable; set STRAND_BIN to the published Millstrand strand"
state_root="$tmp_root/state"
workspace_root="$tmp_root/workspace"
mkdir -p "$state_root" "$workspace_root"
mill_log="$tmp_root/mill.log"
mill_pid=""
weaver_workspace="$workspace_root/.millstrand"
weaver_active=0
XDG_STATE_HOME="$state_root" MILLSTRAND_SOURCE="$core_root" \
  "$mill_bin" start >"$mill_log" 2>&1 &
mill_pid=$!
metadata_path=""
deadline=$((SECONDS + 30))
until [[ -n "$metadata_path" && -f "$metadata_path" ]]; do
  kill -0 "$mill_pid" 2>/dev/null || die "mill exited before publishing runtime metadata: $(sed -n '1,80p' "$mill_log")"
  ((SECONDS < deadline)) || die "mill did not publish runtime metadata within 30s"
  metadata_path=$(find "$state_root" -type f -name mill.json -print -quit)
  sleep 0.05
done
deadline=$((SECONDS + 30))
until XDG_STATE_HOME="$state_root" "$mill_bin" status >/dev/null 2>&1; do
  kill -0 "$mill_pid" 2>/dev/null || die "mill exited before becoming ready: $(sed -n '1,80p' "$mill_log")"
  ((SECONDS < deadline)) || die "mill did not become ready within 30s"
  sleep 0.05
done

mill_cmd() {
  XDG_STATE_HOME="$state_root" MILLSTRAND_SOURCE="$core_root" "$mill_bin" "$@"
}
strand_cmd() {
  XDG_STATE_HOME="$state_root" "$strand_bin" --workspace "$weaver_workspace" "$@"
}

mill_cmd init --workspace "$weaver_workspace" >/dev/null
[[ -d "$weaver_workspace" ]] || die "mill init did not create .millstrand"

# Use the candidate's workspace modules in disposable paths. Project its
# approved provider families rather than maintaining a second workspace config
# here; only the agent-harness roots are overridden to the candidate under
# test, while core, Millhouse, and Kanban keep their immutable release
# identities explicit.
candidate_coord="$candidate_root/.millstrand"
cp -R "$candidate_coord/." "$weaver_workspace/"
for root in harness-core claude-harness codex-harness cursor-harness pi-harness agent-cli agent-run delegation bench; do
  ln -s "$candidate_root/$root" "$workspace_root/$root"
done
cat >"$weaver_workspace/init.local.clj" <<'EOF'
(require '[millstrand.api.current.alpha :as current]
         '[millstrand.api.runtime.alpha :as runtime])

(def runtime (current/runtime))

(runtime/module! runtime :release-harnesses
                 {:file "config/harnesses.clj"
                  :spools ['ct.spools/delegation 'ct.spools/agent-run]
                  :after [:millstrand/spools-agent-run :millstrand/spools-delegation]
                  :required? true})
EOF
cat >"$weaver_workspace/config/harnesses.clj" <<'EOF'
(ns harnesses
  "Disposable release smoke harness and its candidate contracts."
  (:require [millstrand.api.current.alpha :as current]
            [millstrand.api.lifecycle.alpha :as lifecycle]
            [ct.spools.agent-run :as shuttle]
            [ct.spools.delegation :as agents]))

(shuttle/defharnesses! smoke-harnesses
  "Disposable release smoke harnesses."
  {:release-smoke {:argv ["sh" "-c"
                          "printf '%s\\n' '{\"type\":\"thread.started\",\"thread_id\":\"release-smoke\"}' '{\"type\":\"item.completed\",\"item\":{\"type\":\"agent_message\",\"text\":\"release smoke\"}}' '{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":2000,\"cached_input_tokens\":500,\"output_tokens\":100,\"reasoning_output_tokens\":20}}'"]
                   :parse :codex-json
                   :preamble? false
                   :cost-rates {:input 1.0 :cache-read 0.1 :output 6.0}}})

(defn open-release-harnesses!
  [{:keys [runtime]}]
  (current/with-runtime runtime
    (shuttle/set-default-review-contract! agents/review-contract)
    (shuttle/set-default-task-contract! agents/worker-contract))
  {:opened :release-harnesses})

(defn close-release-harnesses!
  [{:keys [runtime]}]
  (current/with-runtime runtime
    (shuttle/set-default-review-contract! nil)
    (shuttle/set-default-task-contract! nil))
  {:closed :release-harnesses})

(lifecycle/defresource! release-harnesses-runtime
  "Own the disposable release smoke contracts."
  {:open 'harnesses/open-release-harnesses!
   :close 'harnesses/close-release-harnesses!})
EOF
[[ -f "$candidate_coord/spools.edn" ]] || die "candidate workspace is missing spools.edn"
clojure -Sdeps '{:deps {}}' -M -e '
(require (quote [clojure.edn :as edn])
         (quote [clojure.string :as string]))
(let [[source-path target-path kanban-url kanban-tag kanban-sha millhouse-url millhouse-sha]
      *command-line-args*
      document (edn/read-string (slurp source-path))
      providers (:spools document)
      required-provider-names ["millhouse/spools" "codethread/spools"
                               "codethread/kanban" "codethread/devflow"]
      missing (remove #(contains? providers (symbol %)) required-provider-names)
      local-roots {"ct.spools/harness-core" "harness-core"
                   "ct.spools/claude-harness" "claude-harness"
                   "ct.spools/codex-harness" "codex-harness"
                   "ct.spools/pi-harness" "pi-harness"
                   "ct.spools/cursor-harness" "cursor-harness"
                   "ct.spools/agent-cli" "agent-cli"
                   "ct.spools/agent-run" "agent-run"
                   "ct.spools/delegation" "delegation"
                   "ct.spools/bench" "bench"}
      local-overrides (into {}
                         (map (fn [[coordinate root]]
                                [(symbol coordinate) {:local/root (str "../" root)}])
                              local-roots))]
  (when (seq missing)
    (throw (ex-info (str "candidate workspace is missing approved provider families: "
                         (string/join ", " missing)) {})))
  (spit target-path
        (pr-str
         (assoc document :spools
                (merge providers
                       local-overrides
                       {(symbol "millhouse/spools")
                        (-> (get providers (symbol "millhouse/spools"))
                            (assoc :git/url millhouse-url :git/sha millhouse-sha)
                            (dissoc :git/tag))
                        (symbol "codethread/kanban")
                        (-> (get providers (symbol "codethread/kanban"))
                            (assoc :git/url kanban-url
                                   :git/tag kanban-tag
                                   :git/sha kanban-sha))})))))
' - "$candidate_coord/spools.edn" "$weaver_workspace/spools.edn" \
  "$kanban_url" "$kanban_tag" "$kanban_sha" "$millhouse_url" "$millhouse_sha"
python3 - "$weaver_workspace/spools.edn" "$kanban_url" "$kanban_tag" "$kanban_sha" "$millhouse_url" "$millhouse_sha" <<'PY'
import pathlib
import sys

path, kanban_url, kanban_tag, kanban_sha, millhouse_url, millhouse_sha = sys.argv[1:]
text = pathlib.Path(path).read_text(encoding="utf-8")
for value in (
    'codethread/spools',
    'millhouse.spools/workflow "spools/workflow"',
    'millhouse.spools.executors/shell "spools/shell-executor"',
    f':git/url "{millhouse_url}"',
    f':git/sha "{millhouse_sha}"',
    f':git/url "{kanban_url}"',
    f':git/tag "{kanban_tag}"',
    f':git/sha "{kanban_sha}"',
):
    if value not in text:
        raise SystemExit(f"projected disposable spools are missing {value}")
if not ('codethread/agents "spools/agents"' in text or
        'agents "spools/agents"' in text):
    raise SystemExit("projected disposable spools are missing codethread agents root")
if not ('codethread/devflow "."' in text or 'devflow "."' in text):
    raise SystemExit("projected disposable spools are missing devflow root")
if not ('codethread/devflow-kanban-adapter "kanban-adapter"' in text or
        'devflow-kanban-adapter "kanban-adapter"' in text):
    raise SystemExit("projected disposable spools are missing devflow Kanban adapter root")
for root in (
    'ct.spools/harness-core', 'ct.spools/claude-harness',
    'ct.spools/codex-harness', 'ct.spools/pi-harness',
    'ct.spools/cursor-harness', 'ct.spools/agent-cli',
    'ct.spools/agent-run', 'ct.spools/delegation', 'ct.spools/bench',
):
    if (f'{root} {{:local/root "../' not in text and
            f'{root} #:local{{:root "../' not in text):
        raise SystemExit(f"projected disposable spools are missing local candidate root {root}")
PY
mill_cmd weaver start --workspace "$weaver_workspace" >/dev/null
weaver_active=1
status_before=$(mill_cmd weaver status --workspace "$weaver_workspace") || \
  die "initial disposable weaver status failed"
printf '%s\n' "$status_before" >"$tmp_root/status-before.json"
python3 - "$tmp_root/status-before.json" "$tmp_root/marker-before.json" "$weaver_workspace" <<'PY'
import json
import os
import sys

status_path, identity_path, workspace = sys.argv[1:]
status = json.load(open(status_path, encoding="utf-8"))
required = ["database_kind", "database_label", "database_path", "state_dir", "data_dir", "weaver_id"]
missing = [key for key in required if not status.get(key)]
if missing:
    raise SystemExit(f"disposable weaver status missing identity fields: {', '.join(missing)}")
if status["database_kind"] != "sqlite-file":
    raise SystemExit(f"disposable weaver did not use sqlite storage: {status['database_kind']}")
if status.get("config_dir") != os.path.realpath(workspace):
    raise SystemExit("disposable weaver selected the wrong canonical workspace")
json.dump({key: status[key] for key in required}, open(identity_path, "w", encoding="utf-8"), indent=2)
PY

state_before=$(strand_cmd add "release marker smoke state" --attr body=release-marker-smoke)
task_id=$(python3 -c 'import json,sys; print(json.loads(sys.stdin.read())["id"])' <<<"$state_before")
[[ -n "$task_id" ]] || die "disposable state creation returned no strand id"
state_before=$(strand_cmd show "$task_id")
printf '%s\n' "$state_before" >"$tmp_root/state-before.json"

mill_cmd weaver stop --workspace "$weaver_workspace" >/dev/null
weaver_active=0
if ! XDG_STATE_HOME="$state_root" "$mill_bin" status >/dev/null 2>&1; then
  XDG_STATE_HOME="$state_root" MILLSTRAND_SOURCE="$core_root" \
    "$mill_bin" start >>"$mill_log" 2>&1 &
  mill_pid=$!
  metadata_path=""
  deadline=$((SECONDS + 30))
  until [[ -n "$metadata_path" && -f "$metadata_path" ]]; do
    kill -0 "$mill_pid" 2>/dev/null || die "mill exited while restarting after marker stop: $(sed -n '1,80p' "$mill_log")"
    ((SECONDS < deadline)) || die "mill did not restart within 30s"
    metadata_path=$(find "$state_root" -type f -name mill.json -print -quit)
    sleep 0.05
  done
  deadline=$((SECONDS + 30))
  until XDG_STATE_HOME="$state_root" "$mill_bin" status >/dev/null 2>&1; do
    kill -0 "$mill_pid" 2>/dev/null || die "mill exited before restart became ready: $(sed -n '1,80p' "$mill_log")"
    ((SECONDS < deadline)) || die "mill restart did not become ready within 30s"
    sleep 0.05
  done
fi
mv "$workspace_root/.millstrand" "$workspace_root/.ms"
weaver_workspace="$workspace_root/.ms"
[[ -d "$weaver_workspace" ]] || die "marker rename did not preserve .ms workspace"
mill_cmd weaver start --workspace "$weaver_workspace" >/dev/null
weaver_active=1
status_after=$(mill_cmd weaver status --workspace "$weaver_workspace") || \
  die "renamed disposable weaver status failed"
printf '%s\n' "$status_after" >"$tmp_root/status-after.json"
state_after=$(strand_cmd show "$task_id")
printf '%s\n' "$state_after" >"$tmp_root/state-after.json"
# Sibling databases and generations may be fresh: UUID continuity is
# intentionally excluded, while storage identity and state remain smoke proof.
python3 - "$tmp_root/status-before.json" "$tmp_root/status-after.json" "$tmp_root/state-before.json" "$tmp_root/state-after.json" "$tmp_root/marker-proof.json" <<'PY'
import json
import sys

status_before, status_after, state_before, state_after, proof_path = sys.argv[1:]
before = json.load(open(status_before, encoding="utf-8"))
after = json.load(open(status_after, encoding="utf-8"))
state_a = json.load(open(state_before, encoding="utf-8"))
state_b = json.load(open(state_after, encoding="utf-8"))
identity = ["database_kind", "database_label", "database_path", "state_dir", "data_dir"]
if any(before[key] != after[key] for key in identity):
    raise SystemExit(".millstrand to .ms changed canonical workspace/database identity")
if state_a != state_b:
    raise SystemExit(".millstrand to .ms changed representative strand state")
for label, status in (("before", before), ("after", after)):
    if not status.get("weaver_id"):
        raise SystemExit(f"disposable weaver status {label} lost its smoke UUID")
json.dump({"database-storage-identity-unchanged": True,
           "representative-functional-state-unchanged": True,
           "weaver-id-continuity": "intentionally-excluded",
           "weaver-id-before": before["weaver_id"],
           "weaver-id-after": after["weaver_id"]},
          open(proof_path, "w", encoding="utf-8"), indent=2)
PY

delegate_result=$(strand_cmd agent delegate "$task_id" --harness release-smoke --cwd "$candidate_root")
delegate_run=$(python3 -c 'import json,sys; print(json.loads(sys.stdin.read())["run"]["id"])' <<<"$delegate_result")
await_result=$(strand_cmd agent await "$delegate_run" --timeout-secs 30)
python3 - "$await_result" <<'PY'
import json
import sys

result = json.loads(sys.argv[1])
runs = result.get("runs", [])
if result.get("timed-out") or len(runs) != 1 or runs[0].get("phase") != "done":
    raise SystemExit(f"delegate/await smoke did not finish successfully: {result}")
PY

review_result=$(strand_cmd agent review "$task_id" --seats 1 --harness release-smoke --cwd "$candidate_root" --changed-files bin/verify-release)
review_runs=$(python3 -c 'import json,sys; print("\\n".join(json.loads(sys.stdin.read())["reviewers"]))' <<<"$review_result")
[[ -n "$review_runs" ]] || die "review smoke returned no reviewer run"
review_count=0
while IFS= read -r review_run; do
  [[ -n "$review_run" ]] || continue
  strand_cmd agent await "$review_run" --timeout-secs 30 >/dev/null
  review_count=$((review_count + 1))
done <<<"$review_runs"
[[ "$review_count" == 1 ]] || die "review smoke returned an unexpected reviewer count: $review_count"

spend_result=$(strand_cmd agent spend --group-by harness)
printf '%s\n' "$spend_result" >"$tmp_root/spend.json"
python3 - "$tmp_root/spend.json" "$tmp_root/smoke-summary.json" <<'PY'
import json
import sys

spend_path, summary_path = sys.argv[1:]
spend = json.load(open(spend_path, encoding="utf-8"))
totals = spend.get("totals", {})
expected_tokens = 4200
expected_cost = 2 * ((1500 / 1_000_000) * 1.0 + (500 / 1_000_000) * 0.1 + (100 / 1_000_000) * 6.0)
if totals.get("tokens-total") != expected_tokens:
    raise SystemExit(f"token accounting smoke mismatch: {totals.get('tokens-total')} != {expected_tokens}")
if abs(totals.get("cost-usd", -1) - expected_cost) > 1e-12:
    raise SystemExit(f"cost accounting smoke mismatch: {totals.get('cost-usd')} != {expected_cost}")
if len(spend.get("runs", [])) != 2:
    raise SystemExit(f"spend smoke expected delegate plus reviewer, got {len(spend.get('runs', []))}")
json.dump({"delegate": True, "await": True, "review": True,
           "spend": True, "tokens-total": expected_tokens,
           "cost-usd": totals["cost-usd"]},
          open(summary_path, "w", encoding="utf-8"), indent=2)
PY

output_dir="$candidate_root/target/release"
mkdir -p "$output_dir"
MODE="$mode" RELEASE_REF="$release_ref" CORE_SHA="$core_sha" KANBAN_TAG="$kanban_tag" \
  MILLHOUSE_SHA="$millhouse_sha" \
  MARKER_PROOF_FILE="$tmp_root/marker-proof.json" SMOKE_SUMMARY_FILE="$tmp_root/smoke-summary.json" \
  OUTPUT_FILE="$output_dir/$mode.json" python3 - <<'PY'
import json
import os

with open(os.environ["MARKER_PROOF_FILE"], encoding="utf-8") as handle:
    marker_proof = json.load(handle)
with open(os.environ["SMOKE_SUMMARY_FILE"], encoding="utf-8") as handle:
    smoke = json.load(handle)
payload = {
    "mode": os.environ["MODE"],
    "release": os.environ["RELEASE_REF"],
    "core-sha": os.environ["CORE_SHA"],
    "millhouse-sha": os.environ["MILLHOUSE_SHA"],
    "kanban-tag": os.environ["KANBAN_TAG"],
    "consumer": "ct.spools/agent-run",
    "marker-proof": marker_proof,
    "agent-smoke": smoke,
}
with open(os.environ["OUTPUT_FILE"], "w", encoding="utf-8") as handle:
    json.dump(payload, handle, indent=2)
    handle.write("\n")
PY

echo "agent-harness release verification: clean"
echo "  mode: $mode"
echo "  release: $release_ref"
echo "  core: $core_repository@$core_sha"
echo "  workflow: $millhouse_repository@$millhouse_sha"
echo "  kanban: $kanban_repository@$kanban_tag ($kanban_sha)"
echo "  evidence: $output_dir/$mode.json"
